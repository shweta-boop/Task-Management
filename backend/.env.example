# Environment Configuration Template
# Copy this to .env and fill in your actual values
# IMPORTANT: .env is in .gitignore and should NEVER be committed

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/task-management?retryWrites=true&w=majority

# JWT Secret - Use a strong random string (minimum 32 characters)
# Generate one: openssl rand -base64 32
JWT_SECRET=your_super_secret_key_here_minimum_32_characters

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4200
